{
  "info": {
    "_postman_id": "3c3c1321-fec5-55da-b47a-92160d4ebc31",
    "name": "API Catálogo de Productos",
    "description": "Pruebas de extremo a extremo (caja negra, HTTP real) de la API del catálogo. Ejecutar en orden: el POST guarda productoId para los requests siguientes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. POST crear producto",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201 Created\", () => {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Respuesta contiene id numérico\", () => {",
              "    const b = pm.response.json();",
              "    pm.expect(b).to.have.property(\"id\");",
              "    pm.expect(b.id).to.be.a(\"number\");",
              "    pm.collectionVariables.set(\"productoId\", b.id);",
              "});",
              "pm.test(\"El cuerpo devuelve los datos enviados\", () => {",
              "    const b = pm.response.json();",
              "    pm.expect(b.nombre).to.eql(\"Teclado mecánico\");",
              "    pm.expect(b.precio).to.eql(120.0);",
              "    pm.expect(b.categoria).to.eql(\"ELECTRONICA\");",
              "});",
              "pm.test(\"Tiempo de respuesta < 500ms\", () => {",
              "    pm.expect(pm.response.responseTime).to.be.below(500);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/productos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos"
          ]
        },
        "description": "Crea un producto válido y guarda su id en la variable de colección productoId.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Teclado mecánico\",\n  \"precio\": 120.0,\n  \"categoria\": \"ELECTRONICA\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "2. GET obtener producto",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200 OK\", () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Content-Type es JSON\", () => {",
              "    pm.response.to.have.header(\"Content-Type\", \"application/json\");",
              "});",
              "pm.test(\"El id coincide con el creado\", () => {",
              "    pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"productoId\")));",
              "});",
              "pm.test(\"El nombre coincide con el creado\", () => {",
              "    pm.expect(pm.response.json().nombre).to.eql(\"Teclado mecánico\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/productos/{{productoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos",
            "{{productoId}}"
          ]
        },
        "description": "Consulta por id el producto creado en el request anterior."
      },
      "response": []
    },
    {
      "name": "3. GET listar por categoría",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200 OK\", () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"La respuesta es un arreglo no vacío\", () => {",
              "    const b = pm.response.json();",
              "    pm.expect(b).to.be.an(\"array\").that.is.not.empty;",
              "});",
              "pm.test(\"Todos los productos son de ELECTRONICA\", () => {",
              "    pm.response.json().forEach(p => pm.expect(p.categoria).to.eql(\"ELECTRONICA\"));",
              "});",
              "pm.test(\"Incluye el producto creado\", () => {",
              "    const ids = pm.response.json().map(p => p.id);",
              "    pm.expect(ids).to.include(Number(pm.collectionVariables.get(\"productoId\")));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/productos?categoria=ELECTRONICA",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos"
          ],
          "query": [
            {
              "key": "categoria",
              "value": "ELECTRONICA"
            }
          ]
        },
        "description": "Lista los productos de la categoría ELECTRONICA."
      },
      "response": []
    },
    {
      "name": "4. GET producto inexistente (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 404 Not Found\", () => {",
              "    pm.response.to.have.status(404);",
              "});",
              "pm.test(\"El mensaje indica el id no encontrado\", () => {",
              "    pm.expect(pm.response.text()).to.include(\"Producto no encontrado: 99999\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/productos/99999",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos",
            "99999"
          ]
        },
        "description": "Un id que no existe debe responder 404 (EntityNotFoundException -> @ExceptionHandler)."
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "productoId",
      "value": "",
      "type": "string"
    }
  ]
}
